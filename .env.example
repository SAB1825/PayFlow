
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/payflow"

ACCESS_TOKEN_SECRET="change-this-to-a-long-random-secret"
ACCESS_TOKEN_EXPIRES_IN="15m"

REFRESH_TOKEN_SECRET="change-this-to-a-different-long-random-secret"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Logging
# Level: silent | error | warn | log | debug | verbose (aliases: info, trace)
LOG_LEVEL="log"
# Format: auto | json | pretty  (auto = json in production, pretty otherwise)
LOG_FORMAT="auto"
# Log every HTTP request/response with a correlation id
LOG_HTTP="true"
# Log database queries; slow queries always log as warnings above SLOW_QUERY_MS
LOG_SQL="false"
# Include query parameters in SQL logs (may contain sensitive values — dev only)
LOG_SQL_PARAMS="false"
SLOW_QUERY_MS="200"
